# Copy to .env; keep keys only on the server. No paid provider calls without your configuration.
PORT=4317
DATA_DIR=./data
# Optional: at least 24 characters. When blank/omitted, data/access-token.txt is generated.
# APP_ACCESS_TOKEN=

# Optional initial fallback. Prefer the web "模型设置" page; saved workspace settings take precedence.
# OpenAI-compatible Chat Completions endpoint with JSON-object support. Never use the workbench access code as LLM_API_KEY.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=90000
# Per-step transport retries for 429 / 5xx / timeouts. 401 and other 4xx are not retried.
# LLM_MAX_ATTEMPTS=3
# Exponential backoff base and cap in milliseconds. A 429 Retry-After header overrides this, capped at 60s.
# LLM_RETRY_BASE_MS=500
# LLM_RETRY_MAX_MS=8000
# Schema or semantic validation failures are sent back to the model up to this many attempts per step.
# LLM_REPAIR_ATTEMPTS=3

# Optional XFYUN Spark shortcut. Setting only this key selects the verified
# Chat Completions endpoint and spark-x2.6 as the environment fallback.
# An explicit LLM_BASE_URL / LLM_MODEL / LLM_API_KEY still takes precedence.
# Never reuse this key for another provider.
# XFYUN_API_KEY=

# Agent-chat cost controls: UTF-8 bytes for the WHOLE normal request, plus recent
# assistant/tool rounds (protocol batches are kept whole). Older history stays on disk.
# Exact selected tool/full-world schemas may exceed the target, never the 768 KiB hard cap.
# CHAT_CONTEXT_TARGET_BYTES=98304
# CHAT_RECENT_TURNS=4
# Per user-triggered run, not per tool call. Includes input+output+cached usage;
# without provider usage, conservatively estimate serialized UTF-8 bytes / 2.
# CHAT_RUN_TOKEN_BUDGET=256000
# Reserved before EVERY request; truncated tool calls are never executed.
# CHAT_MAX_OUTPUT_TOKENS=8192
# KUAIPAO_API_KEY is DEVELOPMENT (OpenCode) ONLY; ignored by the product by default.
# Do NOT enable this in project tests. An exceptional product opt-in requires BOTH
# an explicit LLM_BASE_URL and LLM_ALLOW_KUAIPAO_RUNTIME=true (default disabled).
