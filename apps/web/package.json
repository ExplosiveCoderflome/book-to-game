    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@novel-game/play-runtime": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.4"
  }
}
