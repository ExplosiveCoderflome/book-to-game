{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "apps/server/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/rules/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
